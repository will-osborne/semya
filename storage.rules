rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Voice notes: authenticated users can read/write
    match /voice_notes/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    // Media (images, videos, thumbnails): authenticated users can read/write
    match /media/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024; // 30 MB max
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
